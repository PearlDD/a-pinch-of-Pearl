NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_UID=

# Server-only: choose gemini or openai for both recipe extraction and speech.
RECIPE_AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional Gemini model overrides.
# GEMINI_RECIPE_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite

# Optional alternative provider: set RECIPE_AI_PROVIDER=openai to use these.
# OPENAI_API_KEY=
# RECIPE_IMPORT_MODEL=gpt-4o-mini
# RECIPE_TRANSCRIPTION_MODEL=whisper-1
